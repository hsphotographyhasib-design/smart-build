# SmartBuild EPPM - Environment Variables
# Copy this to .env.local for local development
# On Vercel: add these in Project Settings > Environment Variables

# =============================================================
# DATABASE (REQUIRED)
# =============================================================
# Local development: file:db/custom.db
# Vercel/Production: Use Turso (libsql) - get one at https://turso.tech
# Example: libsql://smart-build-db-yourname.turso.io
DATABASE_URL="file:db/custom.db"

# For Turso, also set:
# DATABASE_AUTH_TOKEN="your-turso-auth-token"

# =============================================================
# AUTH (REQUIRED)
# =============================================================
# JWT secret for session tokens (generate with: openssl rand -base64 32)
AUTH_SECRET="change-me-to-a-random-secret"

# =============================================================
# OPTIONAL
# =============================================================
# NEXTAUTH_URL="https://your-domain.com"
# NEXTAUTH_SECRET=""
