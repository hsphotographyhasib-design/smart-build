/* ================================================================ */
/*  MAIN PAGE COMPONENT                                              */
/* ================================================================ */
export default function HomePage() {
  const [data, setData] = useState<CMSData>({})
  const [scrolled, setScrolled] = useState(false)
  const [annual, setAnnual] = useState(false)
  const [faqSearch, setFaqSearch] = useState('')
  const [screenshotIdx, setScreenshotIdx] = useState(0)
  const [testimIdx, setTestimIdx] = useState(0)

  useEffect(() => {
    fetch('/api/cms/landing')
      .then(r => r.json())
      .then(setData)
      .catch(() => { /* use defaults */ })
  }, [])

  useEffect(() => {
    const h = () => setScrolled(window.scrollY > 50)
    window.addEventListener('scroll', h, { passive: true })
    return () => window.removeEventListener('scroll', h)
  }, [])

  const menu = data.menu?.length ? data.menu : defaultMenu
  const testimonials = data.testimonials?.length ? data.testimonials : defaultTestimonials
  const faqs = (data.faqs?.length ? data.faqs : defaultFAQs).filter(f =>
    !faqSearch || f.question.toLowerCase().includes(faqSearch.toLowerCase()) || f.answer.toLowerCase().includes(faqSearch.toLowerCase())
  )
  const partners = data.partners?.length ? data.partners : defaultPartners
  const plans = (data.plans?.length ? data.plans : defaultPlans).filter(p => p.active).sort((a, b) => a.sortOrder - b.sortOrder)
  const blogPosts = data.blogPosts?.length ? data.blogPosts : defaultBlogPosts
  const caseStudies = data.caseStudies?.length ? data.caseStudies : defaultCaseStudies

  const isSectionVisible = useCallback((type: string) => {
    if (!data.page?.sections?.length) return true
    return data.page.sections.some(s => s.type === type && s.visible)
  }, [data.page?.sections])

  return (
    <div className="min-h-screen flex flex-col bg-background text-foreground">
      <HeaderSection menu={menu} scrolled={scrolled} />
      <main className="flex-1">
        {isSectionVisible('hero') && <HeroSection />}
        {isSectionVisible('trusted') && <TrustedSection partners={partners} />}
        {isSectionVisible('platform') && <PlatformSection />}
        {isSectionVisible('features') && <FeaturesSection />}
        {isSectionVisible('industries') && <IndustriesSection />}
        {isSectionVisible('enterprise') && <EnterpriseSection />}
        {isSectionVisible('workflow') && <WorkflowSection />}
        {isSectionVisible('ai') && <AISection />}
        {isSectionVisible('screenshots') && <ScreenshotsSection idx={screenshotIdx} setIdx={setScreenshotIdx} />}
        {isSectionVisible('testimonials') && <TestimonialsSection items={testimonials} idx={testimIdx} setIdx={setTestimIdx} />}
        {isSectionVisible('cases') && <CaseStudiesSection items={caseStudies} />}
        {isSectionVisible('stats') && <StatsSection />}
        {isSectionVisible('pricing') && <PricingSection plans={plans} annual={annual} setAnnual={setAnnual} />}
        {isSectionVisible('faq') && <FAQSection faqs={faqs} search={faqSearch} setSearch={setFaqSearch} />}
        {isSectionVisible('news') && <NewsSection />}
        {isSectionVisible('blog') && <BlogSection posts={blogPosts} />}
        {isSectionVisible('partners') && <PartnersSection partners={partners} />}
        {isSectionVisible('cta') && <CTASection />}
      </main>
      <FooterSection />
      <BrandFooter />
    </div>
  )
}

/* ================================================================ */
/*  1. HEADER                                                        */
/* ================================================================ */
function HeaderSection({ menu, scrolled }: { menu: MenuItem[]; scrolled: boolean }) {
  const [open, setOpen] = useState(false)
  return (
    <header className={`fixed top-0 inset-x-0 z-50 transition-all duration-300 ${scrolled ? 'glass-dark shadow-lg' : 'bg-transparent'}`}>
      <div className="container-brand flex items-center justify-between h-16 lg:h-[4.5rem]">
        <Link href="/" className="flex items-center gap-2 shrink-0">
          <Image src="/brand/smartbuild-primary-logo.svg" alt="SmartBuild" width={140} height={36} className="h-8 lg:h-9 w-auto" priority />
        </Link>
        <nav className="hidden lg:flex items-center gap-1">
          {menu.map((item) => (
            item.children ? (
              <NavDropdown key={item.label} label={item.label} items={item.children} />
            ) : (
              <Link key={item.label} href={item.href || '#'} className="px-3 py-2 text-sm font-medium text-white/80 hover:text-white transition-colors rounded-md hover:bg-white/5">
                {item.label}
              </Link>
            )
          ))}
        </nav>
        <div className="hidden lg:flex items-center gap-2">
          <Button variant="ghost" className="text-white/80 hover:text-white hover:bg-white/10">Login</Button>
          <Button variant="ghost" className="text-white/80 hover:text-white hover:bg-white/10">Register</Button>
          <Button className="bg-accent hover:bg-accent/90 text-primary-foreground font-semibold">Request Demo</Button>
        </div>
        <Sheet open={open} onOpenChange={setOpen}>
          <SheetTrigger asChild className="lg:hidden">
            <Button variant="ghost" size="icon" className="text-white"><Menu /></Button>
          </SheetTrigger>
          <SheetContent side="right" className="w-[300px] bg-primary text-primary-foreground">
            <SheetHeader><SheetTitle className="text-primary-foreground">Menu</SheetTitle></SheetHeader>
            <nav className="flex flex-col gap-1 mt-6">
              {menu.map((item) => (
                item.children ? (
                  item.children.map(child => (
                    <Link key={child.label} href={child.href || '#'} onClick={() => setOpen(false)} className="px-3 py-2.5 text-sm rounded-md hover:bg-white/10 transition-colors">{item.label} → {child.label}</Link>
                  ))
                ) : (
                  <Link key={item.label} href={item.href || '#'} onClick={() => setOpen(false)} className="px-3 py-2.5 text-sm rounded-md hover:bg-white/10 transition-colors font-medium">{item.label}</Link>
                )
              ))}
              <div className="mt-4 flex flex-col gap-2">
                <Button variant="outline" className="border-white/20 text-primary-foreground">Login</Button>
                <Button variant="outline" className="border-white/20 text-primary-foreground">Register</Button>
                <Button className="bg-accent text-primary-foreground font-semibold">Request Demo</Button>
              </div>
            </nav>
          </SheetContent>
        </Sheet>
      </div>
    </header>
  )
}

function NavDropdown({ label, items }: { label: string; items: MenuItem[] }) {
  return (
    <div className="relative group">
      <button className="flex items-center gap-1 px-3 py-2 text-sm font-medium text-white/80 hover:text-white transition-colors rounded-md hover:bg-white/5">
        {label} <ChevronDown className="w-3.5 h-3.5 transition-transform group-hover:rotate-180" />
      </button>
      <div className="absolute top-full left-0 pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200">
        <div className="glass-dark rounded-lg p-2 min-w-[200px] shadow-xl">
          {items.map(item => (
            <Link key={item.label} href={item.href || '#'} className="block px-3 py-2 text-sm text-white/80 hover:text-white hover:bg-white/10 rounded-md transition-colors">{item.label}</Link>
          ))}
        </div>
      </div>
    </div>
  )
}

