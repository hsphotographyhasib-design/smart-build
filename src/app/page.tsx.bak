/* ================================================================ */
/*  14. PRICING                                                      */
/* ================================================================ */
function PricingSection({ plans, annual, setAnnual }: { plans: Plan[]; annual: boolean; setAnnual: (v: boolean) => void }) {
  return (
    <section id="pricing" className="section-padding bg-background">
      <div className="container-brand">
        <SectionHeader badge="Pricing" title="Plans for Every Scale" titleHighlight="Every Scale" description="Transparent pricing with no hidden fees. Start free, scale as you grow." />
        <InView className="flex items-center justify-center gap-3 mb-12">
          <span className={`text-sm font-medium ${!annual ? 'text-foreground' : 'text-muted-foreground'}`}>Monthly</span>
          <button onClick={() => setAnnual(!annual)} className={`relative w-12 h-6 rounded-full transition-colors ${annual ? 'bg-accent' : 'bg-muted-foreground/30'}`}>
            <div className={`absolute top-1 w-4 h-4 rounded-full bg-white shadow transition-transform ${annual ? 'left-7' : 'left-1'}`} />
          </button>
          <span className={`text-sm font-medium ${annual ? 'text-foreground' : 'text-muted-foreground'}`}>Annual <Badge variant="secondary" className="ml-1 text-xs bg-accent/10 text-accent border-accent/20">Save 20%</Badge></span>
        </InView>
        <StaggerInView className="grid md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-4">
          {plans.map((plan) => {
            const features: string[] = (() => { try { return JSON.parse(plan.features) } catch { return [] } })()
            const isPro = plan.name === 'Professional'
            const isCustom = plan.priceMonthly === 0 && plan.priceAnnual === 0
            return (
              <motion.div key={plan.name} variants={staggerChild}>
                <Card className={`h-full flex flex-col transition-all duration-300 hover:shadow-lg ${isPro ? 'border-2 border-accent relative' : ''}`}>
                  {isPro && <div className="absolute -top-3 left-1/2 -translate-x-1/2"><Badge className="bg-accent text-primary-foreground px-3 py-0.5 text-xs font-semibold">Most Popular</Badge></div>}
                  <CardHeader className="pb-4">
                    <CardTitle className="font-heading text-lg">{plan.name}</CardTitle>
                    <p className="text-xs text-muted-foreground">{plan.description}</p>
                    <div className="mt-3">
                      {isCustom ? (
                        <div className="text-3xl font-bold font-heading">Custom</div>
                      ) : (
                        <div className="flex items-baseline gap-1">
                          <span className="text-3xl font-bold font-heading">${annual ? plan.priceAnnual : plan.priceMonthly}</span>
                          <span className="text-sm text-muted-foreground">/user/mo</span>
                        </div>
                      )}
                    </div>
                  </CardHeader>
                  <CardContent className="flex-1 flex flex-col">
                    <ul className="flex-1 space-y-2 mb-6">
                      {features.map((f: string) => (
                        <li key={f} className="flex items-start gap-2 text-sm"><CheckCircle2 className="w-4 h-4 text-accent shrink-0 mt-0.5" /><span>{f}</span></li>
                      ))}
                    </ul>
                    <Button className={`w-full ${isPro ? 'bg-accent hover:bg-accent/90 text-primary-foreground' : ''}`} variant={isPro ? 'default' : 'outline'}>
                      {isCustom ? 'Contact Sales' : 'Get Started'} <ArrowRight className="ml-1 w-3.5 h-3.5" />
                    </Button>
                  </CardContent>
                </Card>
              </motion.div>
            )
          })}
        </StaggerInView>
      </div>
    </section>
  )
}

/* ================================================================ */
/*  15. FAQ                                                          */
/* ================================================================ */
function FAQSection({ faqs, search, setSearch }: { faqs: FAQ[]; search: string; setSearch: (s: string) => void }) {
  const categories = [...new Set(faqs.map(f => f.category).filter(Boolean))] as string[]
  const [activeCat, setActiveCat] = useState<string | null>(null)
  const filtered = activeCat ? faqs.filter(f => f.category === activeCat) : faqs
  return (
    <section id="faq" className="section-padding bg-muted/30">
      <div className="container-brand max-w-3xl">
        <SectionHeader badge="FAQ" title="Frequently Asked Questions" titleHighlight="Questions" description="Find answers to common questions about SmartBuild platform and services." />
        <InView>
          <div className="relative mb-6">
            <Search className="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-muted-foreground" />
            <Input placeholder="Search questions..." value={search} onChange={(e) => setSearch(e.target.value)} className="pl-10 bg-background" />
          </div>
          {categories.length > 0 && (
            <div className="flex flex-wrap gap-2 mb-6">
              <Badge variant={activeCat === null ? 'default' : 'secondary'} className="cursor-pointer" onClick={() => setActiveCat(null)}>All</Badge>
              {categories.map(c => (
                <Badge key={c} variant={activeCat === c ? 'default' : 'secondary'} className="cursor-pointer" onClick={() => setActiveCat(activeCat === c ? null : c)}>{c}</Badge>
              ))}
            </div>
          )}
          <Accordion type="single" collapsible className="space-y-2">
            {filtered.map((faq, i) => (
              <AccordionItem key={i} value={`faq-${i}`} className="bg-background rounded-lg px-4 border border-border/50">
                <AccordionTrigger className="text-left font-medium hover:no-underline">{faq.question}</AccordionTrigger>
                <AccordionContent className="text-muted-foreground leading-relaxed">{faq.answer}</AccordionContent>
              </AccordionItem>
            ))}
          </Accordion>
          {filtered.length === 0 && <p className="text-center text-muted-foreground py-8">No questions match your search.</p>}
        </InView>
      </div>
    </section>
  )
}

/* ================================================================ */
/*  16. LATEST NEWS                                                  */
/* ================================================================ */
function NewsSection() {
  return (
    <section className="section-padding bg-background">
      <div className="container-brand">
        <SectionHeader badge="Latest News" title="What's Happening at SmartBuild" titleHighlight="SmartBuild" />
        <StaggerInView className="grid md:grid-cols-3 gap-6">
          {newsItems.map((news, i) => (
            <motion.div key={i} variants={staggerChild}>
              <Card className="group h-full hover:shadow-md transition-all duration-300 cursor-pointer">
                <CardContent className="p-6">
                  <div className="flex items-center gap-2 text-xs text-muted-foreground mb-3">
                    <Newspaper className="w-3.5 h-3.5" /><time>{news.date}</time>
                  </div>
                  <h3 className="font-heading font-semibold text-base mb-2 group-hover:text-accent transition-colors leading-snug">{news.title}</h3>
                  <p className="text-sm text-muted-foreground leading-relaxed">{news.excerpt}</p>
                  <div className="mt-4 flex items-center gap-1 text-sm font-medium text-accent">Read more <ArrowUpRight className="w-3.5 h-3.5" /></div>
                </CardContent>
              </Card>
            </motion.div>
          ))}
        </StaggerInView>
      </div>
    </section>
  )
}

/* ================================================================ */
/*  17. BLOG                                                         */
/* ================================================================ */
function BlogSection({ posts }: { posts: BlogPost[] }) {
  return (
    <section id="blog" className="section-padding bg-muted/30">
      <div className="container-brand">
        <SectionHeader badge="Blog" title="Insights & Resources" titleHighlight="Insights" description="Expert articles, industry trends, and best practices from our team." />
        <StaggerInView className="grid md:grid-cols-3 gap-6">
          {posts.map((post) => (
            <motion.div key={post.slug} variants={staggerChild}>
              <Card className="group h-full overflow-hidden hover:shadow-lg transition-all duration-300 cursor-pointer">
                <div className="aspect-video bg-gradient-to-br from-primary/80 to-primary relative">
                  <div className="absolute inset-0 flex items-center justify-center"><BookOpen className="w-12 h-12 text-white/10" /></div>
                </div>
                <CardContent className="p-5">
                  <div className="flex items-center gap-3 text-xs text-muted-foreground mb-3">
                    <time>{post.date}</time><span>·</span><span>{post.readTime}</span>
                  </div>
                  <h3 className="font-heading font-semibold text-base mb-2 group-hover:text-accent transition-colors leading-snug">{post.title}</h3>
                  <p className="text-sm text-muted-foreground leading-relaxed line-clamp-2">{post.excerpt}</p>
                  <div className="mt-4 flex items-center gap-2">
                    <div className="w-6 h-6 rounded-full bg-primary/10 flex items-center justify-center text-accent text-[10px] font-bold">{post.author[0]}</div>
                    <span className="text-xs text-muted-foreground font-medium">{post.author}</span>
                  </div>
                </CardContent>
              </Card>
            </motion.div>
          ))}
        </StaggerInView>
      </div>
    </section>
  )
}

