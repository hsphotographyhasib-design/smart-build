/* ================================================================ */
/*  10. SCREENSHOTS                                                  */
/* ================================================================ */
function ScreenshotsSection({ idx, setIdx }: { idx: number; setIdx: (i: number) => void }) {
  return (
    <section className="section-padding bg-background">
      <div className="container-brand">
        <SectionHeader badge="Platform Preview" title="See SmartBuild in Action" titleHighlight="in Action" description="Explore the intuitive interface and powerful features of our platform." />
        <InView className="relative max-w-4xl mx-auto">
          <div className="relative aspect-video rounded-2xl overflow-hidden shadow-2xl">
            <AnimatePresence mode="wait">
              <motion.div
                key={idx}
                initial={{ opacity: 0 }} animate={{ opacity: 1 }} exit={{ opacity: 0 }}
                className={`absolute inset-0 bg-gradient-to-br ${screenshots[idx].gradient} flex items-center justify-center`}
              >
                <div className="text-center text-white p-8">
                  <LayoutDashboard className="w-16 h-16 mx-auto mb-4 text-white/30" />
                  <h3 className="font-heading text-2xl font-bold mb-2">{screenshots[idx].title}</h3>
                  <p className="text-white/60">{screenshots[idx].desc}</p>
                  <div className="mt-6 grid grid-cols-3 gap-3 max-w-md mx-auto">
                    {['Analytics', 'Reports', 'Tasks', 'Team', 'Budget', 'Timeline'].map((t) => (
                      <div key={t} className="glass rounded-lg p-2 text-xs text-white/50">{t}</div>
                    ))}
                  </div>
                </div>
              </motion.div>
            </AnimatePresence>
          </div>
          <div className="flex items-center justify-center gap-3 mt-6">
            <Button variant="outline" size="icon" className="rounded-full" onClick={() => setIdx((idx - 1 + screenshots.length) % screenshots.length)}><ChevronLeft className="w-4 h-4" /></Button>
            <div className="flex gap-2">
              {screenshots.map((_, i) => (
                <button key={i} onClick={() => setIdx(i)} className={`h-2.5 rounded-full transition-all ${i === idx ? 'bg-accent w-8' : 'bg-muted-foreground/30 hover:bg-muted-foreground/50 w-2.5'}`} />
              ))}
            </div>
            <Button variant="outline" size="icon" className="rounded-full" onClick={() => setIdx((idx + 1) % screenshots.length)}><ChevronRight className="w-4 h-4" /></Button>
          </div>
        </InView>
      </div>
    </section>
  )
}

/* ================================================================ */
/*  11. TESTIMONIALS                                                 */
/* ================================================================ */
function TestimonialsSection({ items, idx, setIdx }: { items: Testimonial[]; idx: number; setIdx: (i: number) => void }) {
  const t = items[idx % items.length]
  return (
    <section className="section-padding bg-muted/30">
      <div className="container-brand">
        <SectionHeader badge="Testimonials" title="What Our Clients Say" titleHighlight="Clients Say" description="Join thousands of enterprises that trust SmartBuild for their project management needs." />
        <InView className="max-w-3xl mx-auto">
          <Card className="relative p-8 md:p-10">
            <Quote className="absolute top-6 right-6 w-12 h-12 text-accent/10" />
            <AnimatePresence mode="wait">
              <motion.div key={idx} initial={{ opacity: 0, x: 20 }} animate={{ opacity: 1, x: 0 }} exit={{ opacity: 0, x: -20 }} transition={{ duration: 0.3 }}>
                <div className="flex gap-1 mb-4">Array.from({ length: 5 }).map((_, i) => <Star key={i} className={`w-4 h-4 ${i < t.rating ? 'text-accent fill-accent' : 'text-muted-foreground/30'}`} />)</div>
                <p className="text-lg md:text-xl text-foreground leading-relaxed mb-6 italic">&ldquo;{t.content}&rdquo;</p>
                <div className="flex items-center gap-4">
                  <div className="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center text-accent font-bold font-heading text-lg">{t.name[0]}</div>
                  <div>
                    <div className="font-heading font-semibold">{t.name}</div>
                    <div className="text-sm text-muted-foreground">{t.role}, {t.company}</div>
                  </div>
                </div>
              </motion.div>
            </AnimatePresence>
            <div className="flex items-center justify-center gap-3 mt-8">
              <Button variant="outline" size="icon" className="rounded-full" onClick={() => setIdx((idx - 1 + items.length) % items.length)}><ChevronLeft className="w-4 h-4" /></Button>
              <div className="flex gap-2">{items.map((_, i) => <button key={i} onClick={() => setIdx(i)} className={`h-2.5 rounded-full transition-all ${i === idx ? 'bg-accent w-8' : 'bg-muted-foreground/30 w-2.5'}`} />)}</div>
              <Button variant="outline" size="icon" className="rounded-full" onClick={() => setIdx((idx + 1) % items.length)}><ChevronRight className="w-4 h-4" /></Button>
            </div>
          </Card>
        </InView>
      </div>
    </section>
  )
}

