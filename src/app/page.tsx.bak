        <StaggerInView className="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4">
          {partners.map((p, i) => (
            <motion.div key={i} variants={staggerChild}>
              <div className="flex items-center justify-center h-20 rounded-xl border border-border/50 bg-card hover:border-accent/30 hover:shadow-sm transition-all duration-200 px-4">
                <span className="font-heading font-bold text-sm text-muted-foreground/60 text-center truncate">{p.name}</span>
              </div>
            </motion.div>
          ))}
        </StaggerInView>
      </div>
    </section>
  )
}

