      <div className="absolute inset-0 pointer-events-none">
        <div className="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-accent/5 rounded-full blur-3xl" />
      </div>
      <div className="container-brand relative z-10 text-center max-w-3xl mx-auto">
        <InView>
          <Rocket className="w-12 h-12 text-accent mx-auto mb-6" />
          <h2 className="font-heading text-3xl md:text-4xl lg:text-5xl font-bold text-white mb-4">
            Ready to <span className="text-gradient">Transform</span> Your Project Management?
          </h2>
          <p className="text-lg text-white/70 mb-10 max-w-xl mx-auto">
            Join 2,500+ enterprises already using SmartBuild to deliver projects faster, smarter, and under budget.
          </p>
          <div className="flex flex-col sm:flex-row gap-4 justify-center">
            <Button size="lg" className="bg-accent hover:bg-accent/90 text-primary-foreground font-semibold h-12 px-8 text-base">
              Start Free Trial <ArrowRight className="ml-2 w-4 h-4" />
            </Button>
            <Button size="lg" variant="outline" className="glass border-white/20 text-white hover:bg-white/10 h-12 px-8 text-base">
              Schedule Demo
            </Button>
          </div>
        </InView>
      </div>
    </section>
  )
}

/* ================================================================ */
/*  20. FOOTER                                                       */
/* ================================================================ */
function FooterSection() {
  const [email, setEmail] = useState('')
  const linkColumns = [
    { title: 'Product', links: ['Features', 'Pricing', 'Integrations', 'API', 'Changelog', 'Security'] },
    { title: 'Solutions', links: ['Construction', 'Infrastructure', 'Healthcare', 'Government', 'Energy', 'Manufacturing'] },
    { title: 'Resources', links: ['Documentation', 'Blog', 'Case Studies', 'Webinars', 'Whitepapers', 'Community'] },
    { title: 'Company', links: ['About Us', 'Careers', 'Press', 'Partners', 'Contact', 'Legal'] },
    { title: 'Support', links: ['Help Center', 'Status', 'Training', 'Onboarding', 'SLA', 'Feedback'] },
  ]
  const socials = [
    { icon: Twitter, label: 'Twitter' }, { icon: Linkedin, label: 'LinkedIn' }, { icon: Facebook, label: 'Facebook' }, { icon: Youtube, label: 'YouTube' },
  ]
  return (
    <footer className="bg-primary text-primary-foreground pt-16 pb-8">
      <div className="container-brand">
        <div className="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-7 gap-8 mb-12">
          <div className="col-span-2">
            <Image src="/brand/smartbuild-primary-logo.svg" alt="SmartBuild" width={140} height={36} className="h-8 w-auto mb-4 brightness-0 invert" />
            <p className="text-sm text-primary-foreground/60 leading-relaxed mb-6 max-w-xs">
              The enterprise project management platform powered by AI. Deliver projects faster with intelligent automation and real-time collaboration.
            </p>
            <div className="flex gap-2">
              <Input placeholder="Enter your email" value={email} onChange={(e) => setEmail(e.target.value)} className="bg-white/10 border-white/10 text-primary-foreground placeholder:text-primary-foreground/40 h-9 text-sm" />
              <Button size="sm" className="bg-accent hover:bg-accent/90 text-primary-foreground shrink-0"><Send className="w-3.5 h-3.5" /></Button>
            </div>
          </div>
          {linkColumns.map((col) => (
            <div key={col.title}>
              <h4 className="font-heading font-semibold text-sm mb-4 text-primary-foreground/90">{col.title}</h4>
              <ul className="space-y-2.5">
                {col.links.map((link) => (
                  <li key={link}><Link href="#" className="text-xs text-primary-foreground/50 hover:text-accent transition-colors">{link}</Link></li>
                ))}
              </ul>
            </div>
          ))}
        </div>
        <div className="border-t border-white/10 pt-8 flex flex-col md:flex-row items-center justify-between gap-4">
          <div className="flex items-center gap-4">
            {socials.map((s) => (
              <a key={s.label} href="#" className="w-9 h-9 rounded-full bg-white/10 flex items-center justify-center hover:bg-accent/20 transition-colors" aria-label={s.label}>
                <s.icon className="w-4 h-4" />
              </a>
            ))}
          </div>
          <div className="flex items-center gap-4 text-xs text-primary-foreground/40">
            <a href="#" className="hover:text-primary-foreground/60 transition-colors flex items-center gap-1"><Mail className="w-3 h-3" /> contact@smartbuild.io</a>
            <a href="#" className="hover:text-primary-foreground/60 transition-colors flex items-center gap-1"><Phone className="w-3 h-3" /> +1 (555) 000-0000</a>
          </div>
          <p className="text-xs text-primary-foreground/40">&copy; {new Date().getFullYear()} SmartBuild. All rights reserved.</p>
        </div>
      </div>
    </footer>
  )
}
