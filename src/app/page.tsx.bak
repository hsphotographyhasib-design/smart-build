            <Button size="lg" variant="outline" className="glass border-white/20 text-white hover:bg-white/10 h-12 px-8 text-base">
              <Play className="mr-2 w-4 h-4" /> Watch Demo
            </Button>
          </div>
        </FadeIn>
        <InView className="mt-16 lg:mt-20 grid grid-cols-2 md:grid-cols-4 gap-6 max-w-3xl mx-auto">
          {[{ v: 2500, s: '+', l: 'Enterprise Clients' }, { v: 98, s: '%', l: 'Client Satisfaction' }, { v: 35, s: '%', l: 'Faster Delivery' }, { v: 50, s: 'M+', l: 'Projects Managed' }].map((s, i) => (
            <div key={i} className="glass rounded-xl p-4 text-center">
              <div className="text-2xl md:text-3xl font-bold font-heading text-gradient">{s.s}{s.v}</div>
              <div className="mt-1 text-xs md:text-sm text-white/60">{s.l}</div>
            </div>
          ))}
        </InView>
      </div>
    </section>
  )
}

