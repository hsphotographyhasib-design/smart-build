    { value: 2500, suffix: '+', label: 'Enterprise Clients' },
    { value: 50, suffix: 'M+', label: 'Projects Managed' },
    { value: 98, suffix: '%', label: 'Client Satisfaction' },
    { value: 35, suffix: '%', label: 'Faster Delivery' },
