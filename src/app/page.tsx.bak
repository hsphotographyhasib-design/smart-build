          <div className="absolute right-0 top-0 bottom-0 w-24 bg-gradient-to-l from-background to-transparent z-10" />
          <motion.div className="flex gap-12 items-center" animate={{ x: ['0%', '-50%'] }} transition={{ duration: 30, repeat: Infinity, ease: 'linear' }}>
            {doubled.map((p, i) => (
              <div key={i} className="shrink-0 flex items-center justify-center h-12 px-8">
                <span className="text-lg font-bold text-muted-foreground/50 whitespace-nowrap font-heading tracking-wide">{p.name}</span>
