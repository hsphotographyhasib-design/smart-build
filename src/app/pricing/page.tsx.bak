import {
  Check,
  Building2,
  Users,
  Zap,
  Shield,
  Crown,
  ArrowRight,
  CheckCircle2,
  XCircle,
} from 'lucide-react'
import { Button } from '@/components/ui/button'
import {
  Card,
  CardContent,
  CardHeader,
  CardTitle,
} from '@/components/ui/card'
import { Badge } from '@/components/ui/badge'
import { Switch } from '@/components/ui/switch'
import { Skeleton } from '@/components/ui/skeleton'
import {
  Accordion,
  AccordionItem,
  AccordionTrigger,
  AccordionContent,
} from '@/components/ui/accordion'
import {
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
} from '@/components/ui/table'
import { BrandFooter } from '@/components/brand'

/* ------------------------------------------------------------------ */
/*  Types                                                              */
/* ------------------------------------------------------------------ */
interface Plan {
  id: string
  name: string
  description: string
  priceMonthly: number
  priceAnnual: number
  maxUsers: number
  maxProjects: number
  maxStorage: number
  maxBranches: number
  maxApiCalls: number
  aiCredits: number
  mobileAccess: boolean
  apiAccess: boolean
  integrations: boolean
  customDomain: boolean
  prioritySupport: boolean
  features: string
  sortOrder: number
  active: boolean
}

/* ------------------------------------------------------------------ */
/*  Animation helper                                                   */
/* ------------------------------------------------------------------ */
function SectionFadeIn({
  children,
  className,
  delay = 0,
}: {
  children: React.ReactNode
  className?: string
  delay?: number
}) {
  return (
    <motion.div
      initial={{ opacity: 0, y: 10 }}
      whileInView={{ opacity: 1, y: 0 }}
      viewport={{ once: true, margin: '-60px' }}
      transition={{ duration: 0.3, delay }}
      className={className}
    >
      {children}
    </motion.div>
  )
}

/* ------------------------------------------------------------------ */
/*  Plan Icon Component (declared outside render)                       */
/* ------------------------------------------------------------------ */
const PLAN_ICONS: Record<string, React.ElementType> = {
  zap: Zap,
  shield: Shield,
  crown: Crown,
  building: Building2,
  users: Users,
}

function getPlanIconKey(name: string): string {
  const lower = name.toLowerCase()
  if (lower.includes('free') || lower.includes('trial')) return 'zap'
  if (lower.includes('starter')) return 'shield'
  if (lower.includes('professional') || lower.includes('pro')) return 'crown'
  if (lower.includes('enterprise') || lower.includes('custom')) return 'building'
  return 'users'
}

function PlanIcon({ name }: { name: string }) {
  const key = getPlanIconKey(name)
  const Icon = PLAN_ICONS[key] || Users
  return <Icon className="h-4 w-4 text-primary" />
}

/* ------------------------------------------------------------------ */
/*  Helpers                                                            */
/* ------------------------------------------------------------------ */
function formatStorage(mb: number): string {
  if (mb >= 100000) return `${(mb / 1000).toFixed(0)} GB`
  if (mb >= 1000) return `${(mb / 1000).toFixed(0)} GB`
  return `${mb} MB`
}

function formatApiCalls(n: number): string {
  if (n >= 1000000) return `${(n / 1000000).toFixed(0)}M`
  if (n >= 1000) return `${(n / 1000).toFixed(0)}K`
  return n === 0 ? '-' : String(n)
}

function getSavings(monthly: number, annual: number): number {
  if (monthly === 0 || annual === 0) return 0
  const annualTotal = annual * 12
  const monthlyTotal = monthly * 12
  return Math.round(((monthlyTotal - annualTotal) / monthlyTotal) * 100)
}

function isProfessionalPlan(name: string): boolean {
  return name.toLowerCase().includes('professional')
}

function isEnterprisePlan(name: string): boolean {
  return name.toLowerCase().includes('enterprise') || name.toLowerCase().includes('custom')
}

function parseFeatures(featuresStr: string): string[] {
  try {
    const parsed = JSON.parse(featuresStr)
    if (Array.isArray(parsed)) return parsed
    return []
  } catch {
    return []
  }
}

