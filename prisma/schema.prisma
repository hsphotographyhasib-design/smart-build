// =============================================================
// SmartBuild Enterprise Multi-Tenant SaaS Platform
// =============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =============================================================
// PLATFORM — TENANTS
// =============================================================

model Tenant {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  domain      String?  @unique
  email       String
  phone       String?
  address     String?
  logoUrl     String?
  faviconUrl  String?
  status      String   @default("Active")
  tier        String   @default("Trial")
  maxUsers    Int      @default(5)
  maxProjects Int      @default(3)
  maxStorage  Int      @default(500)
  maxBranches Int      @default(1)
  currentUsers   Int   @default(0)
  currentProjects Int @default(0)
  currentStorage  Int @default(0)
  trialEndsAt DateTime?
  expiresAt   DateTime?
  approvedBy  String?
  approvedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  settings    TenantSettings?
  subscription TenantSubscription?
  branding    TenantBranding?
  domains     TenantDomain[]
  features    TenantFeature[]
  branches    Branch[]
  users       AppUser[]
  roles       Role[]
  auditLogs   AuditLog[]
}

model TenantSettings {
  id              String   @id @default(cuid())
  tenantId        String   @unique
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  defaultLanguage String   @default("en")
  defaultTimezone String   @default("Asia/Singapore")
  dateFormat      String   @default("DD/MM/YYYY")
  currency        String   @default("MYR")
  fiscalYearStart Int      @default(1)
  smtpHost        String?
  smtpPort        Int?
  smtpUser        String?
  smtpPass        String?
  smtpFrom        String?
  whatsappApiUrl  String?
  whatsappApiToken String?
  paymentGateway  String?
  paymentConfig   String?
  enableRegistration Boolean @default(false)
  requireApproval   Boolean @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model TenantDomain {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  domain    String   @unique
  primary   Boolean  @default(false)
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([tenantId])
}

model TenantBranding {
  id            String   @id @default(cuid())
  tenantId      String   @unique
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  primaryColor  String   @default("#0B2345")
  accentColor   String   @default("#F5A623")
  textColor     String?  @default("#FFFFFF")
  sidebarColor  String?  @default("#0B2345")
  loginBgImage  String?
  loginBgColor  String?  @default("#0B2345")
  fontFamily    String?  @default("Inter")
  logoUrl       String?
  logoDarkUrl   String?
  logoLightUrl  String?
  iconUrl       String?
  emailHeader   String?
  emailFooter   String?
  invoiceTemplate String?
  reportHeader  String?
  reportFooter  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// =============================================================
// PLATFORM — SUBSCRIPTIONS & PLANS
// =============================================================

model SubscriptionPlan {
  id             String   @id @default(cuid())
  name           String   @unique
  description    String?
  priceMonthly   Float    @default(0)
  priceAnnual    Float    @default(0)
  maxUsers       Int      @default(5)
  maxProjects    Int      @default(3)
  maxStorage     Int      @default(500)
  maxBranches    Int      @default(1)
  maxApiCalls    Int      @default(1000)
  aiCredits      Int      @default(0)
  mobileAccess   Boolean  @default(false)
  apiAccess      Boolean  @default(false)
  integrations   Boolean  @default(false)
  customDomain   Boolean  @default(false)
  prioritySupport Boolean @default(false)
  features       String   @default("[]")
  sortOrder      Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subscriptions  TenantSubscription[]
}

model TenantSubscription {
  id              String   @id @default(cuid())
  tenantId        String   @unique
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId          String
  plan            SubscriptionPlan @relation(fields: [planId], references: [id])
  status          String   @default("Active")
  billingCycle    String   @default("monthly")
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  trialStart     DateTime?
  trialEnd       DateTime?
  cancelAtPeriodEnd Boolean @default(false)
  paymentMethodId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model TenantFeature {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  module    String
  enabled   Boolean  @default(true)
  config    String?
  createdAt DateTime @default(now())

  @@unique([tenantId, module])
  @@index([tenantId])
}

// =============================================================
// TENANT — ORGANIZATIONAL HIERARCHY
// =============================================================

model Branch {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  code      String
  address   String?
  phone     String?
  email     String?
  managerId String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  departments Department[]
  users       AppUser[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Department {
  id        String   @id @default(cuid())
  tenantId  String
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name      String
  code      String?
  managerId String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, branchId, name])
  @@index([tenantId])
  @@index([branchId])
}

// =============================================================
// TENANT — ROLES & PERMISSIONS (RBAC)
// =============================================================

model Role {
  id          String   @id @default(cuid())
  tenantId    String?
  name        String
  description String?
  level       Int      @default(0)
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions Permission[]
  users       AppUser[] @relation("UserRole")
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Permission {
  id        String   @id @default(cuid())
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  resource  String
  action    String
  scope     String   @default("own")
  createdAt DateTime @default(now())

  @@unique([roleId, resource, action])
  @@index([roleId])
}

// =============================================================
// TENANT — USERS
// =============================================================

model AppUser {
  id           String    @id @default(cuid())
  tenantId     String?
  tenant       Tenant?   @relation(fields: [tenantId], references: [id])
  branchId     String?
  branch       Branch?   @relation(fields: [branchId], references: [id])
  departmentId String?
  roleId       String?
  userRole     Role?     @relation("UserRole", fields: [roleId], references: [id])
  name         String
  email        String
  role         String    @default("Customer")
  roleLevel    Int       @default(10)
  avatar       String?
  phone        String?
  active       Boolean   @default(true)
  passwordHash String?
  provider     String    @default("email")
  googleId     String?   @unique
  lastLoginAt  DateTime?
  createdBy    String?
  updatedBy    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([tenantId, email])
}

model OtpChallenge {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String
  expiresAt DateTime
  consumed  Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([phone])
}

// =============================================================
// TENANT — AUDIT LOGS
// =============================================================

model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
  userId      String?
  userName    String?
  action      String
  resource    String
  resourceId  String?
  details     String?
  ipAddress   String?
  userAgent   String?
  level       String   @default("info")
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
}

// =============================================================
// TENANT — BUSINESS DATA (all scoped by tenantId + branchId)
// =============================================================

model Portfolio {
  id          String   @id @default(cuid())
  tenantId    String
  branchId    String?
  code        String
  name        String
  businessUnit String?
  department  String?
  client      String?
  description String?
  status      String   @default("Active")
  health      String   @default("Green")
  budget      Float    @default(0)
  startDate   DateTime?
  endDate     DateTime?
  managerId   String?
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  programs    Program[]
  projects    Project[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([branchId])
}

model Program {
  id          String   @id @default(cuid())
  tenantId    String
  branchId    String?
  code        String
  name        String
  description String?
  status      String   @default("Active")
  health      String   @default("Green")
  budget      Float    @default(0)
  managerId   String?
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  startDate   DateTime?
  endDate     DateTime?
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projects    Project[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([branchId])
}

model Project {
  id            String   @id @default(cuid())
  tenantId      String
  branchId      String?
  code          String
  name          String
  description   String?
  status        String   @default("Active")
  health        String   @default("Green")
  category      String?
  priority      String   @default("Medium")
  budget        Float    @default(0)
  actualCost    Float    @default(0)
  committedCost Float    @default(0)
  forecastCost  Float    @default(0)
  revenue       Float    @default(0)
  progress      Float    @default(0)
  startDate     DateTime?
  finishDate    DateTime?
  baselineStart DateTime?
  baselineFinish DateTime?
  portfolioId   String?
  portfolio     Portfolio? @relation(fields: [portfolioId], references: [id])
  programId     String?
  program       Program?   @relation(fields: [programId], references: [id])
  managerId     String?
  client        String?
  location      String?
  createdBy     String?
  updatedBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  wbs           Wbs[]
  activities    Activity[]
  risks         Risk[]
  baselines     Baseline[]
  changes       ChangeOrder[]
  documents     Document[]
  reports       DailyReport[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([branchId])
}

model Wbs {
  id          String   @id @default(cuid())
  tenantId    String
  branchId    String?
  code        String
  name        String
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      Wbs?     @relation("WbsTree", fields: [parentId], references: [id])
  children    Wbs[]    @relation("WbsTree")
  level       Int      @default(1)
  weight      Float    @default(0)
  progress    Float    @default(0)
  startDate   DateTime?
  finishDate  DateTime?
  budget      Float    @default(0)
  actualCost  Float    @default(0)
  isMilestone Boolean  @default(false)
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  activities  Activity[]

  @@index([tenantId])
  @@index([projectId])
}

model Activity {
  id            String   @id @default(cuid())
  tenantId      String
  branchId      String?
  activityId    String
  name          String
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  wbsId         String?
  wbs           Wbs?     @relation(fields: [wbsId], references: [id])
  type          String   @default("Task Activity")
  status        String   @default("Not Started")
  duration      Float    @default(0)
  remainingDur  Float    @default(0)
  actualDur     Float    @default(0)
  startDate     DateTime?
  finishDate    DateTime?
  earlyStart    DateTime?
  earlyFinish   DateTime?
  lateStart     DateTime?
  lateFinish    DateTime?
  baselineStart DateTime?
  baselineFinish DateTime?
  progress      Float    @default(0)
  totalFloat    Float    @default(0)
  freeFloat     Float    @default(0)
  isCritical    Boolean  @default(false)
  constraint    String?
  constraintDate DateTime?
  calendar      String   @default("Standard 5d")
  responsible   String?
  cost          Float    @default(0)
  actualCost    Float    @default(0)
  createdBy     String?
  updatedBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  predecessors  Dependency[] @relation("Successor")
  successors    Dependency[] @relation("Predecessor")
  assignments   ResourceAssignment[]

  @@index([tenantId])
  @@index([projectId])
}

model Dependency {
  id            String @id @default(cuid())
  tenantId      String
  predecessorId String
  successorId   String
  type          String @default("FS")
  lag           Float  @default(0)
  predecessor   Activity @relation("Predecessor", fields: [predecessorId], references: [id], onDelete: Cascade)
  successor     Activity @relation("Successor", fields: [successorId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Resource {
  id         String   @id @default(cuid())
  tenantId   String
  branchId   String?
  code       String
  name       String
  type       String   @default("Labour")
  role       String?
  unit       String   @default("day")
  rate       Float    @default(0)
  maxUnits   Float    @default(8)
  calendar   String   @default("Standard 5d")
  department String?
  phone      String?
  email      String?
  status     String   @default("Active")
  createdBy  String?
  updatedBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  assignments ResourceAssignment[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model ResourceAssignment {
  id          String  @id @default(cuid())
  tenantId    String
  activityId  String
  resourceId  String
  activity    Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  resource    Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  plannedUnits Float  @default(0)
  actualUnits  Float  @default(0)
  remainingUnits Float @default(0)
  cost        Float   @default(0)
  unitsPerDay Float   @default(1)

  @@index([tenantId])
}

model Risk {
  id          String   @id @default(cuid())
  tenantId    String
  branchId    String?
  code        String
  title       String
  description String?
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category    String   @default("Schedule")
  probability Int      @default(3)
  impact      Int      @default(3)
  score       Int      @default(9)
  status      String   @default("Open")
  strategy    String?
  mitigation  String?
  owner       String?
  responseCost Float   @default(0)
  raisedDate  DateTime @default(now())
  dueDate     DateTime?
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@index([projectId])
}

model Baseline {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type        String   @default("Project")
  isCurrent   Boolean  @default(false)
  startDate   DateTime?
  finishDate  DateTime?
  budget      Float    @default(0)
  duration    Float    @default(0)
  notes       String?
  createdBy   String?
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@index([projectId])
}

model ChangeOrder {
  id          String   @id @default(cuid())
  tenantId    String
  branchId    String?
  code        String
  title       String
  description String?
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type        String   @default("Variation")
  status      String   @default("Submitted")
  costImpact  Float    @default(0)
  timeImpact  Float    @default(0)
  raisedBy    String?
  raisedDate  DateTime @default(now())
  approvedDate DateTime?
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@index([projectId])
}

model Document {
  id         String   @id @default(cuid())
  tenantId   String
  branchId   String?
  name       String
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type       String   @default("Drawing")
  category   String?
  version    String   @default("1.0")
  status     String   @default("Draft")
  uploadedBy String?
  fileUrl    String?
  createdBy  String?
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([projectId])
}

model DailyReport {
  id         String   @id @default(cuid())
  tenantId   String
  branchId   String?
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reportDate DateTime
  weather    String?
  manpower   Int      @default(0)
  progress   String?
  notes      String?
  delays     String?
  supervisor String?
  createdBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId])
  @@index([projectId])
}

// =============================================================
// CMS — PAGES & SECTIONS
// =============================================================

model CmsPage {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  path          String   @unique
  description   String?
  status        String   @default("draft")
  seoTitle      String?
  seoDescription String?
  seoKeywords   String?
  ogImage       String?
  canonicalUrl  String?
  schemaMarkup  String?
  locale        String   @default("en")
  isHomePage    Boolean  @default(false)
  publishedAt   DateTime?
  scheduledAt   DateTime?
  version       Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sections      CmsSection[]
  versions      CmsPageVersion[]

  @@index([status])
  @@index([locale])
}

model CmsSection {
  id        String   @id @default(cuid())
  pageId    String
  type      String
  name      String
  order     Int      @default(0)
  visible   Boolean  @default(true)
  config    Json
  styles    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  page      CmsPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, order])
  @@index([type])
}

model CmsPageVersion {
  id        String   @id @default(cuid())
  pageId    String
  version   Int
  data      Json
  note      String?
  createdAt DateTime @default(now())

  page      CmsPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, version])
  @@index([pageId])
}

// =============================================================
// CMS — MEDIA
// =============================================================

model CmsMedia {
  id        String   @id @default(cuid())
  name      String
  alt       String?
  type      String
  mimeType  String?
  size      Int      @default(0)
  width     Int?
  height    Int?
  url       String
  thumbUrl  String?
  folder    String   @default("/")
  tags      String   @default("[]")
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([folder])
}

// =============================================================
// CMS — BLOG
// =============================================================

model CmsBlogCategory {
  id          String @id @default(cuid())
  name        String
  slug        String @unique
  description String?
  color       String?
  order       Int    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  posts       CmsBlogPostCategory[]
}

model CmsBlogPost {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  excerpt         String?
  content         String
  coverImage      String?
  coverAlt        String?
  status          String    @default("draft")
  featured        Boolean   @default(false)
  locale          String    @default("en")
  seoTitle        String?
  seoDescription  String?
  seoKeywords     String?
  ogImage         String?
  publishedAt     DateTime?
  scheduledAt     DateTime?
  authorName      String?
  authorAvatar    String?
  readingTime     Int       @default(5)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  categories      CmsBlogPostCategory[]
  postTags        CmsBlogPostTag[]
  comments         CmsBlogComment[]

  @@index([status, publishedAt])
  @@index([locale])
  @@index([featured])
}

model CmsBlogPostCategory {
  postId     String
  categoryId String

  post       CmsBlogPost    @relation(fields: [postId], references: [id], onDelete: Cascade)
  category   CmsBlogCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([postId, categoryId])
}

model CmsBlogTag {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique
  posts CmsBlogPostTag[]
}
model CmsBlogPostTag {
  postId String
  tagId   String

  post  CmsBlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag   CmsBlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([postId, tagId])
}

model CmsBlogComment {
  id        String   @id @default(cuid())
  postId    String
  author    String
  email     String?
  content   String
  status    String   @default("pending")
  createdAt DateTime @default(now())

  post      CmsBlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, status])
}

// =============================================================
// CMS — FORMS & LEADS
// =============================================================

model CmsForm {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  config      Json
  successMsg  String?
  errorMsg    String?
  notifyEmail String?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  submissions  CmsFormSubmission[]
}

model CmsFormSubmission {
  id          String   @id @default(cuid())
  formId      String
  data        Json
  status      String   @default("new")
  source      String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm    String?
  utmContent  String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  form        CmsForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId, status])
  @@index([createdAt])
}

// =============================================================
// CMS — TESTIMONIALS & CASE STUDIES
// =============================================================

model CmsTestimonial {
  id          String   @id @default(cuid())
  name        String
  position    String?
  company     String?
  companyLogo String?
  avatar      String?
  content     String
  rating      Int      @default(5)
  featured    Boolean  @default(false)
  order       Int      @default(0)
  status      String   @default("published")
  locale      String   @default("en")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([featured])
  @@index([status, order])
}

model CmsCaseStudy {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  client      String?
  industry    String?
  summary     String?
  content     String
  coverImage  String?
  results     Json?
  featured    Boolean  @default(false)
  status      String   @default("published")
  locale      String   @default("en")
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([industry])
  @@index([featured])
}

// =============================================================
// CMS — PARTNERS & FAQ
// =============================================================

model CmsPartner {
  id        String   @id @default(cuid())
  name      String
  logo      String
  url       String?
  category  String   @default("client")
  order     Int      @default(0)
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, order])
}

model CmsFaq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String?
  order     Int      @default(0)
  locale    String   @default("en")
  status    String   @default("published")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, order])
  @@index([locale])
}

// =============================================================
// CMS — ANALYTICS & NEWSLETTER
// =============================================================

model CmsAnalyticsConfig {
  id                        String   @id @default(cuid())
  googleAnalytics            String?
  googleTagManager         String?
  microsoftClarity         String?
  metaPixel                 String?
  linkedinInsight           String?
  facebookDomainVerification String?
  headScripts              String?
  bodyScripts              String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}

model CmsNewsletter {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  source    String?
  status    String   @default("subscribed")
  createdAt DateTime @default(now())
}

// =============================================================
// CMS — I18N
// =============================================================

model CmsTranslation {
  id        String @id @default(cuid())
  key       String
  locale    String
  value     String
  context   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key, locale])
  @@index([locale])
  @@index([context])
}

// =============================================================
// CMS — MENUS
// =============================================================

model CmsMenuItem {
  id        String   @id @default(cuid())
  label     String
  url       String?
  type      String   @default("link")
  parentId   String?
  icon      String?
  target    String   @default("_self")
  order     Int      @default(0)
  visible   Boolean  @default(true)
  locale    String   @default("en")
  menu      String   @default("main")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  parent    CmsMenuItem?  @relation("MenuItems", fields: [parentId], references: [id], onDelete: SetNull)
  children  CmsMenuItem[]  @relation("MenuItems")

  @@index([menu, order])
  @@index([parentId])
}
